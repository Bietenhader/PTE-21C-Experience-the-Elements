{
  "name": "pte-21c",
  "version": "0.0.0",
  "private": true,
  "description": "PTE-21C — Experience the Elements. A quantum-aware, photographic, swipeable periodic table.",
  "license": "CC-BY-NC-SA-4.0",
  "author": "Bietenhader (Fin)",
  "homepage": "https://bietenhader.github.io/PTE-21C-Experience-the-Elements/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bietenhader/PTE-21C-Experience-the-Elements.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node tools/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "gen:types": "node tools/gen-types.mjs",
    "check:types": "node tools/gen-types.mjs --check",
    "check:licences": "node tools/check-licences.mjs",
    "lighthouse": "node tools/lighthouse.mjs"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@react-three/fiber": "9.8.1",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "d3-shape": "3.2.0",
    "katex": "0.18.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.56.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "lighthouse": "13.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
