 "history": {
  "discovered": "antiquity",
  "nameOrigin": "From the Old English iren (isern), a word of Germanic origin.",
  "symbolNote": "Fe comes from the Latin ferrum.",
  "source": "pubchem"
 },
 "prose": {
  "text": "Iron is the most used of all metals, mostly as steel, and the main ingredient of Earth's core; in our blood it carries oxygen inside haemoglobin, and plants need it to make chlorophyll, so iron-starved leaves turn pale. Its common isotope, iron-56, about 91.8 % of natural iron, has one of the most tightly bound nuclei of all, which is why the fusion fires of massive stars stop releasing energy once their cores turn to iron. The atom, [Ar] 3d⁶ 4s² (ground term ⁵D₄), has four unpaired d electrons, and in the solid metal the spins of neighbouring atoms line up, making iron magnetic.",
  "sources": [
   "iaea_livechart",
   "nist_gsie"
  ]
 }
