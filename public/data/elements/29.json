 "history": {
  "discovered": "antiquity",
  "nameOrigin": "From the Latin cuprum, from aes Cyprium, 'metal of Cyprus', the Romans' main source.",
  "symbolNote": "Cu comes from the Latin cuprum.",
  "source": "pubchem"
 },
 "prose": {
  "text": "Copper is a soft, reddish metal that conducts electricity better than any other except silver, which is why it runs through our walls as wiring; alloyed with tin it gave the Bronze Age its name, and with zinc it becomes brass. Plants need traces of it too, for plastocyanin, a small copper protein that ferries electrons in photosynthesis. Copper breaks the simple filling rule: the Aufbau order predicts [Ar] 3d⁹ 4s², but measurement shows [Ar] 3d¹⁰ 4s¹, a completely filled d subshell plus one s electron (ground term ²S₁/₂). In the metal, those d electrons absorb blue and green light, leaving copper its warm colour.",
  "sources": [
   "nist_gsie"
  ]
 }
}
