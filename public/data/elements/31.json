 "history": {
  "discovered": 1875,
  "discoverers": [
   "Paul-Émile Lecoq de Boisbaudran"
  ],
  "nameOrigin": "From Gallia, the Latin name of France; it may also pun on the discoverer's name, since the Latin gallus means 'rooster' (le coq).",
  "source": "pubchem",
  "note": "Mendeleev's predicted eka-aluminium, found by its spectrum in zinc blende. Jefferson Lab and Los Alamos say Lecoq obtained the metal by electrolysis the same year; CIAAW dates the first isolation to 1878, together with Jungfleisch."
 },
 "prose": {
  "text": "Gallium is a soft, silvery metal that melts at 302.91 K (about 30 °C), so a lump turns liquid in a warm hand, yet it does not boil until 2477 K; like water, it expands as it freezes. It was discovered in 1875 through two new violet lines, at 403.3 and 417.2 nm, in the spectrum of a zinc ore, and today gallium nitride makes the blue and white LEDs in lamps and screens. The atom is [Ar] 3d¹⁰ 4s² 4p¹ (ground term ²P°₁/₂). Its filled 3d subshell shields the nucleus poorly, so its first ionisation energy, 579 kJ/mol, almost equals aluminium's despite eighteen extra protons.",
  "sources": [
   "pubchem",
   "nist_lines",
   "nist_gsie"
  ]
 }
}
