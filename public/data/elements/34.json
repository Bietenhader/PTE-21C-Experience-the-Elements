 "biology": {
  "essentialPlant": "beneficial",
  "essentialHuman": "yes",
  "plantClass": "beneficial",
  "plantRole": {
   "text": "Not needed by plants, but at low levels it can raise antioxidant defences; some 'hyperaccumulator' plants store very large amounts, and crops are a main route of selenium into our diet.",
   "source": "marschner2012",
   "doi": "10.1016/B978-0-12-384905-2.00008-X"
  },
  "humanRole": {
   "text": "Built into selenoproteins such as glutathione peroxidases, which protect cells from oxidation, and into enzymes that activate thyroid hormone.",
   "source": "efsa_drv",
   "doi": "10.2903/sp.efsa.2017.e15121"
  },
  "environment": [
   {
    "text": "Selenium leached from soils by irrigation drainage collected in the Kesterson ponds in California in the early 1980s and caused deformed and dead embryos in water birds.",
    "source": "primary_literature",
    "doi": "10.1016/0048-9697(86)90104-X"
   }
  ],
