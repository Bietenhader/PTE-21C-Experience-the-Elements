 "history": {
  "discovered": 1817,
  "discoverers": [
   "Jöns Jacob Berzelius"
  ],
  "place": "Stockholm, Sweden",
  "nameOrigin": "From the Greek selene, 'Moon', as a companion to tellurium, which is named after the Earth.",
  "source": "pubchem",
  "note": "Found in residue from a Swedish sulfuric acid works; Berzelius first took it for tellurium.",
  "placeLocation": {
   "lat": 59.324,
   "lon": 18.066,
   "source": "natural_earth"
  }
 },
 "prose": {
  "text": "Selenium is a nonmetal that comes as a red powder or as grey, metallic-looking crystals; it was named after the Moon, as a partner to tellurium, named after the Earth. Selenium conducts electricity far better in light than in the dark, a property put to work in early light sensors and in photocopier drums. Animals need traces of it, yet some milkvetch plants hoard enough in their leaves to poison grazing livestock. The atom is [Ar] 3d¹⁰ 4s² 4p⁴ (ground term ³P₂). Selenium-82, 8.82 % of the natural element, is radioactive, but it decays by double beta decay so slowly, with a half-life of about 9.6 × 10¹⁹ years, that it far outlasts the age of the universe.",
  "sources": [
   "iaea_livechart",
   "nist_gsie"
  ]
 }
}
