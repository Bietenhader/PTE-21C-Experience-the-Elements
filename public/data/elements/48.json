  ]
 },
 "history": {
  "discovered": 1817,
  "discoverers": [
   "Friedrich Stromeyer"
  ],
  "place": "Göttingen, Germany",
  "nameOrigin": "From the Latin cadmia (Greek kadmeia), the old name for calamine, the zinc ore in which it was found.",
  "source": "pubchem",
  "note": "Noticed because some zinc carbonate samples turned yellow on heating.",
  "placeLocation": {
   "lat": 51.52,
   "lon": 9.92,
   "source": "natural_earth"
  }
 },
 "prose": {
  "text": "Cadmium is a soft, bluish-white metal obtained as a by-product of zinc refining; it is highly toxic, yet it has served in nickel–cadmium batteries, in reactor control rods because it swallows neutrons, and in the vivid cadmium yellows and reds of artists’ paints. Friedrich Stromeyer found it in 1817 after noticing that a zinc carbonate sample turned yellow when heated, a sign of an unknown impurity. Its closed-shell atom ([Kr] 4d¹⁰ 5s², ground term ¹S₀) emits a sharp red spectral line at 643.8 nm, between two excited singlet levels, so reproducible that it served for decades as an international reference for measuring length.",
  "sources": [
   "pubchem",
   "nist_gsie",
   "nist_lines"
  ]
 }
}
