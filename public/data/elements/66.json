 "history": {
  "discovered": 1886,
  "discoverers": [
   "Paul-Émile Lecoq de Boisbaudran"
  ],
  "nameOrigin": "From the Greek dysprositos, 'hard to get at', for the difficulty of separating it.",
  "source": "pubchem",
  "note": "Sources disagree on its isolation: CIAAW and Jefferson Lab credit Georges Urbain (1906), while Los Alamos says fairly pure oxide and metal only became available through ion-exchange work around 1950. Delafontaine's 1878 'philippia' was an earlier, mistaken claim (CIAAW)."
 },
 "prose": {
  "text": "Dysprosium is a soft, silvery lanthanide whose name comes from the Greek for ‘hard to get at’, after the long series of painstaking separations Paul-Émile Lecoq de Boisbaudran needed to detect it in 1886. Today it is quietly vital: a little dysprosium added to neodymium magnets keeps them strong at the high temperatures inside electric-car motors and wind-turbine generators. Its atom ([Xe] 4f¹⁰ 6s²) has four unpaired 4f electrons and a ground level ⁵I₈ with total angular momentum J = 8, the largest of any element, shared only with californium, which makes dysprosium atoms among the most magnetic known.",
  "sources": [
   "pubchem",
   "nist_gsie"
  ]
 }
