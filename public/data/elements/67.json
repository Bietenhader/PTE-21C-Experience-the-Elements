  "discoverers": [
   "Marc Delafontaine",
   "Jacques-Louis Soret",
   "Per Teodor Cleve"
  ],
  "nameOrigin": "From Holmia, the Latin name of Stockholm, Cleve's home city.",
  "source": "pubchem",
  "note": "Delafontaine and Soret saw its absorption bands and called it 'element X'; Cleve independently separated its oxide from erbia and named it. CIAAW and Los Alamos say pure holmia (the oxide) was first prepared in 1911."
 },
 "prose": {
  "text": "Holmium is a soft, silvery lanthanide named after Stockholm, the home city of Per Teodor Cleve, one of its discoverers. When cold, its metal is among the most strongly magnetic substances known, so holmium pole pieces are used to concentrate the fields of the strongest laboratory magnets. Holmium oxide has such sharp, reliable absorption bands that glass or solutions containing it are used to check the wavelength scale of spectrophotometers. Its only stable isotope, holmium-165, has nuclear spin 7/2 and a large magnetic moment, which spreads the atom’s spectral lines into wide hyperfine patterns; the electron ground level, from [Xe] 4f¹¹ 6s², is ⁴I°₁₅/₂.",
  "sources": [
   "pubchem",
   "nist_gsie",
   "iaea_livechart"
  ]
 }
}
